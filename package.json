{
  "name": "nit",
  "version": "1.2.0",
  "private": true,
  "description": "Keyboard-first local code review, with Claude as a second reader",
  "homepage": "https://sidwebworks.com/things/nit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidwebworks/nit.git"
  },
  "author": "Sidharth Rathi (https://sidwebworks.com)",
  "license": "MIT",
  "keywords": [
    "code-review",
    "git",
    "github",
    "pull-request",
    "claude",
    "cli"
  ],
  "type": "module",
  "bin": {
    "nit": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "NIT_DEV=1 bun src/cli.ts",
    "dev:ui": "bunx --bun vite",
    "typecheck": "tsc --noEmit",
    "build:ui": "bun src/build.ts",
    "compile": "bun scripts/compile.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@base-ui/react": "^1.9.0",
    "@ff-labs/fff-bun": "^0.11.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.169.0",
    "@pierre/diffs": "1.6.4",
    "@pierre/theming": "1.0.2",
    "@pierre/trees": "1.0.0",
    "@silk-hq/components": "^0.10.2",
    "@tanstack/react-query": "^5.107.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "fzf": "0.5.2",
    "iconoir-react": "^7.12.2",
    "octokit": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.22",
    "streamdown": "^2.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@octokit/graphql-schema": "^15.26.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-transform-react": "^0.158.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
